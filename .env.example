# Copy to .env and fill in. .env is gitignored: never commit it.

# NJ Transit developer portal credentials (https://developer.njtransit.com)
NJT_USERNAME=your-username
NJT_PASSWORD=your-password

# Stop ID or stop code (the number on the bus stop sign, or see stops.txt in the GTFS feed)
STOP_ID=12345
# route:headsign-keywords (case-insensitive, | = or). Check /debug for real headsigns.
ROUTES=158:new york,126:hoboken
POLL_SECONDS=30
# GPS estimate for buses with no NJT prediction: assume bus is this much faster than timetable pace
GPS_SPEEDUP_MPH=5
